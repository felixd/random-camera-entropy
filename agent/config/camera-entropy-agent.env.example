# Camera Entropy Go agent
DEVICE=auto
SCAN_DEVICES=/dev/video0,/dev/video1,/dev/video2
WIDTH=1280
HEIGHT=720
CAMERA_FPS=10
MANUAL_EXPOSURE=1
EXPOSURE=7000
STRICT_MODE=1
CONTROL_CHECK_SECONDS=60
CONTROL_FAIL_CONSECUTIVE=1
LISTEN_HOST=0.0.0.0
TLS_PORT=9443
TLS_CA=/etc/camera-entropy/pki/ca.crt
TLS_CERT=/etc/camera-entropy/pki/agent.crt
TLS_KEY=/etc/camera-entropy/pki/agent.key
SOURCE_ID=camera
ALLOWED_CLIENT_CN=camera-compute
SOCKET_TIMEOUT_SECONDS=60
CLIENT_BACKLOG_FRAMES=16
